# ===============================================
# Unreal Engine 4 Generated Files
# ===============================================

# Binary and intermediate files
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/

# Build results
*.sln
*.vcxproj
*.vcxproj.filters
*.xcodeproj
*.suo
*.opensdf
*.sdf
*.opendb
*.VC.db

# Visual Studio and Rider cache
.vs/
.idea/

# macOS files
.DS_Store

# UE4 Editor temp files
*.autosave
*.log

# Compiled assets
*.generated.h

# Localization (if not needed)
Localization/

# Plugins (if using precompiled plugins)
Plugins/**/Binaries/
Plugins/**/Intermediate/

# ===============================================
# Optional (Project-specific exclusions)
# ===============================================

# If using Perforce or other SCM
*.p4ignore

# Large asset files (if not using Git LFS)
#*.uasset
#*.umap